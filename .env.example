# Copy to apps/web/.env.local. Every block is optional except Core + Auth; see docs/runbooks/SETUP.md.

# ---- Core ----
NODE_ENV=development
DATABASE_URL=postgres://user:pass@host/desk            # Neon/Supabase; tests and demo mode use PGlite and ignore this
DATABASE_POOL_MAX=5
APP_URL=http://localhost:3000
DESK_SECRETS_KEY=                                       # openssl rand -base64 48 — encrypts ERP credentials

# ---- Demo mode (no accounts needed; ignored when Clerk is configured) ----
# DESK_DEMO=1
# DESK_DEMO_DATA_DIR=.pglite/desk                       # or :memory:

# ---- LLM (Anthropic) ----
ANTHROPIC_API_KEY=
DESK_EXTRACT_MODEL=claude-opus-5-5                      # extraction + L4 re-rank
DESK_CLASSIFY_MODEL=claude-haiku-5-5                    # classification + routing
DESK_MODEL_BUDGET_USD_PER_DOC=0.15                      # Phase 1 budget (plan §7.5)

# ---- Auth (Clerk, with Organizations enabled) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ---- Billing (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_METER_EVENT=desk_order_posted
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_OVERAGE=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_GROWTH_OVERAGE=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_SCALE_OVERAGE=

# ---- Email (Postmark) ----
POSTMARK_SERVER_TOKEN=                                  # outbound: acknowledgments, digest
POSTMARK_FROM=orders@example.com
POSTMARK_INBOUND_SECRET=                                # password in the inbound webhook URL (basic auth)
INBOUND_DOMAIN=orders.example.com                       # tenants receive at <slug>@INBOUND_DOMAIN

# ---- Job runner (Inngest) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1                                         # with `npx inngest-cli dev`

# ---- ERP: QuickBooks Online ----
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox                                 # sandbox | production

# ---- Storage (R2/S3); local disk (BLOB_DIR) when unset ----
S3_ENDPOINT=
S3_BUCKET=desk-documents
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# BLOB_DIR=.data/blobs

# ---- Observability (reserved, not yet wired) ----
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
