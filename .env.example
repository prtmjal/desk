# ---- Core ----
NODE_ENV=development
DATABASE_URL=postgres://user:pass@host/desk            # Neon/Supabase; tests use PGlite and ignore this
APP_URL=http://localhost:3000

# ---- LLM (Anthropic) ----
ANTHROPIC_API_KEY=
DESK_EXTRACT_MODEL=claude-opus-5-5                      # extraction + L4 re-rank
DESK_CLASSIFY_MODEL=claude-haiku-5-5                    # classification + routing
DESK_MODEL_BUDGET_USD_PER_DOC=0.15                      # Phase 1 budget (plan §7.5)

# ---- Auth (Clerk) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ---- Billing (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email ----
POSTMARK_SERVER_TOKEN=                                  # inbound + outbound
INBOUND_DOMAIN=orders.example.com

# ---- Storage (R2/S3) ----
S3_ENDPOINT=
S3_BUCKET=desk-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Observability ----
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
